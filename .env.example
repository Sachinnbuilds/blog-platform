# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file to git.

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/blog_platform
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-db-password-here

# JWT - must be at least 32 characters, use a random string
JWT_SECRET=replace-this-with-a-long-random-secret-key-min-32-chars

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudinary (leave empty to disable image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
